{
  "name": "stockwatch",
  "version": "0.1.0",
  "description": "Self-hosted back-in-stock watcher. Polls product pages, detects restocks, pings your phone.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "stockwatch": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "restock",
    "stock-alert",
    "price-tracker",
    "web-scraping",
    "monitoring",
    "ntfy",
    "playwright"
  ],
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
